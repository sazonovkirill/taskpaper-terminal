#!/bin/bash
# Runs the required validation before any push (AGENTS.md, Sources of truth). There is no CI to catch a skipped run.
set -euo pipefail

head="$(git rev-parse HEAD)"
branches=0
while read -r _ local_sha remote_ref _; do
  if [[ "$remote_ref" != refs/heads/* || "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  branches=1
  if [[ "$local_sha" != "$head" ]]; then
    echo "pre-push: pushing $local_sha but HEAD is $head; check out the commit you push so validation runs on its contents" >&2
    exit 1
  fi
done
((branches)) || exit 0
if [[ -n "$(git status --porcelain)" ]]; then
  echo 'pre-push: the worktree has uncommitted changes; commit or set them aside so validation runs on the pushed contents' >&2
  exit 1
fi
bash app/scripts/validate.sh all
