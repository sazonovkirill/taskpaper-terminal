# With animations reduced a refused @ shows a one-step flash and its hint, and editing goes on.
env COLORTERM=truecolor
config <<END
theme = "nord"
animations = "reduced"
END
file <<END
- Call
END
keys <Enter>
type  @mom
status Tags are set with commands
keys <Esc>
see - Call mom
quit
saved <<END
- Call mom
END
