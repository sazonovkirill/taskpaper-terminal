# Indenting a selection and undoing at once, while the moved rows are tinted, puts every block back.
env COLORTERM=truecolor
config <<END
theme = "nord"
END
file <<END
- Alpha
- Beta
- Gamma
- Delta
END
keys j <S-Down> <S-Down> <Tab>
see ▌   - Delta
keys z
quit
saved <<END
- Alpha
- Beta
- Gamma
- Delta
END
