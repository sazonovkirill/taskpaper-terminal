# o followed by s, p, t or n adds a section, project, task or note below the focused block.
file <<END
Project:
	- Task one
END
see Task one
keys j os
type Sec
keys <Esc> op
type Proj
keys <Esc> on
type Nt
keys <Esc> Ot
type Tsk
keys <Esc>
see - Tsk
quit
saved <<END
Project:
	- Task one
	Sec @section
	Proj:
	- Tsk
	Nt
END
