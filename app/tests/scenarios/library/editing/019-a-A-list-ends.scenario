# a adds a block at the end of the focused block's list and A at its start, at once, so the letters typed after them are the new blocks' text.
file <<END
Project:
	- Middle
	Notes
END
see Middle
keys j at
type ask
keys <Esc> As
type tart
keys <Esc>
see - start
quit
saved <<END
Project:
	- start
	- Middle
	Notes
	task
END
