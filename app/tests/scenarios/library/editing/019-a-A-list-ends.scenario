# a adds a block at the end of the focused block's list and A at its start, here a task and a section.
file <<END
Project:
	- Middle
	Notes
END
see Middle
keys j at
type End task
keys <Esc> As
type Start section
keys <Esc>
see Start section
quit
saved <<END
Project:
	Start section @section
	- Middle
	Notes
	- End task
END
