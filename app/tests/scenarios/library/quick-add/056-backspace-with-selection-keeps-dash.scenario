# Backspace at the start deletes the dash only with nothing selected: with text selected it deletes that text.
file <<END
INBOX: @inbox
END
keys q
type Draft memo
keys <Home> <S-Right> <S-Right> <S-Right> <S-Right> <S-Right> <S-Right> <BS>
see - memo
keys <Del>
see - emo
keys <Enter>
quit
saved <<END
INBOX: @inbox
	- emo
END
