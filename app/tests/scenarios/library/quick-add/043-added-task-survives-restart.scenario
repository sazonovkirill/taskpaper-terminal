# A quick add saved before quitting is there when the file is opened again, with its start chip.
file <<END
INBOX: @inbox
	- Old item
END
keys q
type Dentist tomorrow
keys <Enter>
restart
see - Dentist
see 󱙭 tomorrow
hide Quick Add
quit
saved <<END
INBOX: @inbox
	- Old item
	- Dentist @start({today+1})
END
