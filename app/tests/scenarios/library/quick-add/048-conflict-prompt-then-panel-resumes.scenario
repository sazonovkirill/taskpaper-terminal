# An outside change with an unsaved quick add asks first; after Keep mine the open panel is back and adds too.
config <<END
autosave_delay_ms = 60000
END
file <<END
INBOX: @inbox
	- Old item
END
keys q
type First
keys <Enter> q
type Second
outside <<END
INBOX: @inbox
	- Old item
	- From outside
END
see Your changes are not saved yet.
keys <C-k>
see - Second
keys <Enter>
quit
saved <<END
INBOX: @inbox
	- Old item
	- First
	- Second
END
