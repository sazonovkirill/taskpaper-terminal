# A reload from disk closes the open project picker, keeps the text, and the picker then lists the new projects.
file <<END
Work:
	- a
END
keys qq
type Plan
keys <Space> /
see Project
outside <<END
Work:
	- a
Holiday:
END
status Reloaded
hide Project
see - Plan
keys /
type holi
keys <Enter> <Enter>
quit
saved <<END
Work:
	- a
Holiday:
	- Plan
END
