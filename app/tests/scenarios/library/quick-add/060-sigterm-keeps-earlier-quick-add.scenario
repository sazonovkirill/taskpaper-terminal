# Told to end while a second Quick Add is open, the app saves the first quick add and drops the half-typed second.
config <<END
autosave_delay_ms = 60000
END
file <<END
INBOX: @inbox
END
keys q
type Saved one
keys <Enter> q
type Lost one
see - Lost one
signal TERM
saved <<END
INBOX: @inbox
	- Saved one
END
