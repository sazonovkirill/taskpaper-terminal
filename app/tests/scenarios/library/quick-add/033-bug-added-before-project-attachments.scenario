# A quick add goes after the destination's NOTE and COMMENTS attachments, as the last child.
file <<END
INBOX: @inbox
	NOTE @hidden
		Inbox rules
	COMMENTS @hidden
		[2026-10-08 00:40] Empty it daily
END
keys q
type Sort mail
keys <Enter>
quit
saved <<END
INBOX: @inbox
	NOTE @hidden
		Inbox rules
	COMMENTS @hidden
		[2026-10-08 00:40] Empty it daily
	- Sort mail
END
