# "/@team" typed where the picker opens ends as text: the "@" follows the slash, so it is no tag and shows after reopening.
file <<END
Work:
END
keys qq
type Ping
keys <Space> /
type @team
see - Ping /@team
keys <Space> / <Enter> <Enter>
restart
see - Ping /@team
quit
saved <<END
Work:
	- Ping /@team
END
