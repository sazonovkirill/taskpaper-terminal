# "@" starting a word is not typed in Quick Add and the status line says why; an "@" inside an address is kept.
file <<END
INBOX: @inbox
END
keys q
type Mail ann@example.com about @launch
status Tags are set in Edit Node (e)
see - Mail ann@example.com about launch
keys <Enter>
quit
saved <<END
INBOX: @inbox
	- Mail ann@example.com about launch
END
