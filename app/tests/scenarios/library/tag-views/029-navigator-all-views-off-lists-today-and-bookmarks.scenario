# With every special view but Today and the inbox turned off, the Navigator lists Today above the Bookmarks heading, and gS still opens the Starred view.
config <<END
sidebar_upcoming = false
sidebar_overdue = false
sidebar_colors = false
sidebar_logbook = false
sidebar_starred = false
sidebar_flagged = false
special_inbox = false
END
file <<END
INBOX:
	- Call mom @star
Reading @bookmark
	- Dune
END
keys <C-g>
see ┌Navigator
see │▌ 󰖙 Today
see │  Bookmarks
hide Starred
keys <Esc> gS
see 󰓎 Starred
see - Call mom 󰓎  INBOX
keys <C-g> <Down>
see │▌ Reading
quit
