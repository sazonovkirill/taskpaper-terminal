# With every special view and the inbox turned off, the Navigator starts with the Bookmarks heading, and gS still opens the Starred view.
config <<END
sidebar_today = false
sidebar_upcoming = false
sidebar_overdue = false
sidebar_colors = false
sidebar_logbook = false
sidebar_starred = false
sidebar_flagged = false
special_inbox = false
END
file <<END
INBOX:
	- Call mom @star
Reading @bookmark
	- Dune
END
keys <C-g>
see ┌Navigator
see │  Bookmarks
hide Starred
keys <Esc> gS
see 󰓎 Starred
see - Call mom 󰓎  INBOX
keys <C-g>
see │▌ Reading
quit
