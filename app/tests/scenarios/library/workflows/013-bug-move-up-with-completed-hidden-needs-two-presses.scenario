# With completed tasks hidden, Alt+k moves a task above the visible task above it in one press.
file <<END
Errands:
	- Bank @done(2026-10-01)
	- Post office
	- Pharmacy @done(2026-10-02)
	- Hardware store
END
keys gc G <A-k>
see ▌   - Hardware store
see     - Post office
quit
saved <<END
Errands:
	- Bank @done(2026-10-01)
	- Hardware store
	- Post office
	- Pharmacy @done(2026-10-02)
END
