# The conflict prompt has no Esc: other keys, plain letters too, do nothing until a choice is made.
config <<END
autosave_delay_ms = 60000
END
file <<END
Errands:
	- Post office
END
keys j x
outside <<END
Errands:
	- Bank
END
see The file changed on disk
keys <Esc> j x m t d
see The file changed on disk
keys <C-r>
quit
saved <<END
Errands:
	- Bank
END
