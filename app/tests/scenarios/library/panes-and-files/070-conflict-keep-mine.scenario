# With an unsaved edit, Ctrl+K in the conflict prompt keeps the app's version and writes it over the file.
config <<END
autosave_delay_ms = 60000
END
file <<END
Errands:
	- Post office
END
keys j x
outside <<END
Errands:
	- Bank
END
see The file changed on disk
keys <C-k>
status Kept mine; theirs is in
saved <<END
Errands:
	- Post office @done({today})
END
