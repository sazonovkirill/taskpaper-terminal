# With an unsaved edit, an outside change asks what to do, and Ctrl+R takes the version on disk.
config <<END
autosave_delay_ms = 60000
END
file <<END
Errands:
	- Post office
END
keys j x
outside <<END
Errands:
	- Post office
	- Bank
END
see The file changed on disk
see Ctrl+K keep mine · Ctrl+R take theirs · Ctrl+L show diff
keys <C-r>
hide The file changed on disk
status Took theirs; mine is in
see     - Bank
quit
saved <<END
Errands:
	- Post office
	- Bank
END
