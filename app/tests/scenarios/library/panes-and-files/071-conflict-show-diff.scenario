# Ctrl+L in the conflict prompt shows a diff from the file on disk to the app's version, and Ctrl+L hides it again.
config <<END
autosave_delay_ms = 60000
END
file <<END
Errands:
	- Post office
END
keys j o
type Bank
keys <Esc>
outside <<END
Errands:
	- Post office
	- Bakery
END
see The file changed on disk
keys <C-l>
see - on disk  + yours
see -   - Bakery
see +   - Bank
see Ctrl+L hide diff
keys <C-l>
hide - on disk  + yours
